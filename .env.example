# Αντιγράψτε αυτό το αρχείο ως .env.local και συμπληρώστε τις τιμές από:
# Supabase → Project Settings → API Keys (και Data API για το URL).
# Στο Vercel βάλτε τις ίδιες μεταβλητές στο Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Το publishable key (sb_publishable_...). Παλαιότερα projects: βάλτε το "anon"
# key στη μεταβλητή NEXT_PUBLIC_SUPABASE_ANON_KEY αντί γι' αυτήν.
# ΠΟΤΕ το secret / service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
